# One style across the workspace: LF, UTF-8, two-space indent, one trailing
# newline. TypeScript, JSON, CSS, HTML, YAML and the shell scripts all use it;
# nothing here indents with 4 spaces or tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,css,html,yml,yaml,sh}]
indent_style = space
indent_size = 2
